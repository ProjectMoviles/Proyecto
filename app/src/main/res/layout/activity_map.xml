<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MapActivity">

    <TextView
        android:id="@+id/tvMapTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:text="@string/map_title"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Filters: one row of 3 buttons -->
    <TableLayout
        android:id="@+id/tlMapFilters"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:stretchColumns="*"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvMapTitle">

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/btnFilterRarity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_rarity"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnFilterPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_price"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnFilterNearby"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_nearby"
                android:textSize="12sp" />
        </TableRow>
    </TableLayout>

    <!-- Map placeholder: gray box with centered text -->
    <TextView
        android:id="@+id/tvMapPlaceholder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:background="#D9D9D9"
        android:gravity="center"
        android:text="@string/map_placeholder"
        android:textSize="18sp"
        app:layout_constraintBottom_toTopOf="@id/tlMapNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tlMapFilters" />

    <!-- Selected dish card (filled by code in the next task) -->
    <LinearLayout
        android:id="@+id/llMapCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:orientation="horizontal"
        android:padding="12dp"
        app:layout_constraintBottom_toTopOf="@id/tlMapNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/ibMapDishPhoto"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:contentDescription="@string/dish_photo_description"
            app:srcCompat="@android:drawable/ic_menu_gallery" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMapDishInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnViewDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/btn_view_detail"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom bar: List and Map -->
    <TableLayout
        android:id="@+id/tlMapNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:stretchColumns="*"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/btnNavList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_list" />

            <Button
                android:id="@+id/btnNavMap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_map" />
        </TableRow>
    </TableLayout>

</androidx.constraintlayout.widget.ConstraintLayout>