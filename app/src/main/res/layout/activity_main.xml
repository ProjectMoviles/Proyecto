<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tvDishListTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:text="@string/dish_list_title"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvDishCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:text="@string/dish_count"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDishListTitle" />

    <EditText
        android:id="@+id/etDishSearch"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="8dp"
        android:hint="@string/dish_search_hint"
        android:inputType="text"
        android:minHeight="48dp"
        app:layout_constraintEnd_toStartOf="@id/ibSearch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDishCount" />


    <ImageButton
        android:id="@+id/ibSearch"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="@string/btn_search"
        app:layout_constraintBottom_toBottomOf="@id/etDishSearch"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/etDishSearch"
        app:srcCompat="@android:drawable/ic_menu_search" />

    <!-- Filters: one row of 4 buttons -->
    <TableLayout
        android:id="@+id/tlFilters"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:stretchColumns="*"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etDishSearch">

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/btnFilterRarity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_rarity"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnFilterPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_price"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnFilterType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_type"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnFilterRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_rating"
                android:textSize="12sp" />
        </TableRow>
    </TableLayout>

    <!-- Dish list: one dish per row, scrolls by itself -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDishList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="88dp"
        app:layout_constraintBottom_toTopOf="@id/tlNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tlFilters" />

    <!-- Add dish button: it will open the form screen -->
    <ImageButton
        android:id="@+id/ibAddDish"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="@string/btn_add_dish"
        app:layout_constraintBottom_toTopOf="@id/tlNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@android:drawable/ic_input_add" />

    <!-- Bottom navigation: List, Map and My diary -->
    <TableLayout
        android:id="@+id/tlNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:stretchColumns="*"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/btnNavList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_list" />

            <Button
                android:id="@+id/btnNavMap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_map" />

            <Button
                android:id="@+id/btnNavDiary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_diary" />
        </TableRow>
    </TableLayout>

</androidx.constraintlayout.widget.ConstraintLayout>